{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "File Catalog",
  "version": "0.1.0",
  "identifier": "app.filecatalog.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeDevCommand": "npm run build:ui:dev",
    "beforeBuildCommand": "npm run build:ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "File Catalog",
        "width": 1200,
        "height": 760,
        "minWidth": 640,
        "minHeight": 400,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
